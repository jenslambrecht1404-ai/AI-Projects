# ============================================================
# Workbook & Buch Generator — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ============================================================

# ── Anthropic / Claude ────────────────────────────────────────
# Required. Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs TTS / Voice Cloning ───────────────────────────
# Required for audio generation. Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Your cloned Voice ID (find it in ElevenLabs > Voices)
# If empty, falls back to the default "Rachel" voice.
ELEVENLABS_VOICE_ID=

# Model to use for TTS. eleven_multilingual_v2 supports German.
# Options: eleven_monolingual_v1, eleven_multilingual_v2, eleven_turbo_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Napkin AI (Future Integration) ───────────────────────────
# Currently using Mermaid.js as fallback. Add key here when API is available.
NAPKIN_API_KEY=

# ── Google Nano Banana 2 (Future Integration) ─────────────────
# Currently using Chart.js + Canvas as fallback. Add key here when API is available.
NANO_BANANA_API_KEY=

# ── App Settings ──────────────────────────────────────────────
# Base URL for the app (used for internal links in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Output directory for generated files (relative to project root)
# Default: ./output
OUTPUT_DIR=output
